<Window x:Class="LabelMeWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelMe WPF 标注工具" Icon="Assets/labelme-icon.ico"
        Width="1440" Height="900" MinWidth="1050" MinHeight="650"
        Background="#171A1F" Foreground="White"
        PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#252A32" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="打开项目  Ctrl+O" Click="OpenFolder_Click" />
        <Button Grid.Column="1" Content="上一张  A" Click="Previous_Click" />
        <Button Grid.Column="2" Content="下一张  D" Click="Next_Click" />
        <TextBlock Grid.Column="3" x:Name="FileNameText" VerticalAlignment="Center" Margin="15,0" FontSize="15" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="4" Content="保存  Ctrl+S" Background="#1769AA" Click="Save_Click" />
        <Button Grid.Column="5" Content="保存并下一张  Space" Background="#197A4A" Click="SaveNext_Click" />
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#252A32" Foreground="White">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="请先打开图片目录" /></StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <Button Content="刷新标注  F5" Padding="8,3" Click="RefreshAnnotations_Click" />
          <Button Content="适应窗口  F" Padding="8,3" Click="FitImage_Click" />
          <TextBlock Text="缩放 " Margin="8,0,0,0" VerticalAlignment="Center" />
          <Slider x:Name="ZoomSlider" Width="130" Minimum="0.02" Maximum="5" Value="1" TickFrequency="0.1" ValueChanged="ZoomSlider_ValueChanged" />
          <TextBlock x:Name="ZoomText" Width="48" Margin="8,0,0,0" VerticalAlignment="Center" Text="100%" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="185" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="图片" FontSize="17" FontWeight="SemiBold" Margin="4,2,4,8" />
            <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="1" Value="0" />
            <TextBlock x:Name="ProgressText" Text="0 / 0 已完成" Margin="4,6,4,10" Foreground="#AEB7C4" />
            <TextBlock Text="JSON 保存目录" Foreground="#AEB7C4" Margin="4,0,4,2" />
            <TextBlock x:Name="AnnotationFolderText" Text="未选择" Margin="4,0,4,10"
                       Foreground="#E8EBEF" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ListBox x:Name="ImageList" Background="#191C21" Foreground="White" BorderThickness="0"
                   SelectionChanged="ImageList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Padding="6,5" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#101216" />

      <Border Grid.Column="2" Background="#101216" ClipToBounds="True">
        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ImageScroll_PreviewMouseWheel">
          <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0A0B0D">
            <Grid.LayoutTransform>
              <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>
            <Image x:Name="MainImage" Stretch="Fill" SnapsToDevicePixels="True" />
            <Canvas x:Name="DrawingCanvas" Background="Transparent" Cursor="Arrow" Focusable="True"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    MouseRightButtonDown="Canvas_MouseRightButtonDown"
                    MouseMove="Canvas_MouseMove" />
          </Grid>
        </ScrollViewer>
      </Border>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#101216" />

      <Border Grid.Column="4" Background="{StaticResource PanelBrush}" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="类别" FontSize="17" FontWeight="SemiBold" Margin="4,2,4,8" />
            <ListBox x:Name="LabelCombo" Height="84" Margin="3"
                     Background="#111419" Foreground="White" BorderBrush="#4A5360" FontWeight="SemiBold">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Foreground" Value="White" />
                  <Setter Property="Background" Value="#111419" />
                  <Setter Property="Padding" Value="7,5" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#1769AA" />
                      <Setter Property="Foreground" Value="White" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Text="新增类别" Foreground="#AEB7C4" Margin="4,7,4,1" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="NewLabelTextBox" Grid.Column="0" Height="30" Margin="3" Padding="6,3"
                       Background="White" Foreground="#111827" CaretBrush="#111827"
                       KeyDown="NewLabelTextBox_KeyDown" />
              <Button Grid.Column="1" Content="添加" Click="AddLabel_Click" />
            </Grid>
            <Button Content="删除当前类别" Click="RemoveLabel_Click" />
            <Separator Margin="0,10" />
            <TextBlock Text="绘制模式" FontSize="15" FontWeight="SemiBold" Margin="4,1,4,5" />
            <Border Background="#171A1F" BorderBrush="#4A5360" BorderThickness="1" CornerRadius="3" Padding="7,5" Margin="3">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PolygonModeRadio" Content="多边形" IsChecked="True"
                             Foreground="White" FontWeight="SemiBold" Margin="3,0,18,0"
                             Checked="DrawingMode_Checked" />
                <RadioButton x:Name="RectangleModeRadio" Content="矩形框"
                             Foreground="White" FontWeight="SemiBold" Checked="DrawingMode_Checked" />
              </StackPanel>
            </Border>
            <Button x:Name="DrawButton" Content="开始绘制  W" Background="#1769AA" Click="Draw_Click" />
            <TextBlock Text="选定模式后会一直保持。统一按 W 开始；多边形逐点单击并靠近起点闭合；矩形单击两次确定。完成后选择类别，Esc 取消。" TextWrapping="Wrap" Foreground="#C8D0DB" Margin="5,7,5,12" />
            <TextBlock Text="当前图片的标注" FontSize="16" FontWeight="SemiBold" Margin="4,2,4,8" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Button Content="删除选中标注  Delete" Background="#74363A" Click="DeleteShape_Click" />
            <Button Content="清空当前图片" Click="ClearShapes_Click" />
          </StackPanel>
          <ListBox x:Name="ShapeList" Background="#191C21" Foreground="White" BorderThickness="0"
                   DisplayMemberPath="DisplayText" SelectionChanged="ShapeList_SelectionChanged" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
