<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\labelme-icon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);build\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\labelme-icon.png" />
    <Resource Include="Assets\labelme-icon.ico" />
  </ItemGroup>
</Project>
