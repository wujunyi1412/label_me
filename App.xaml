<Application x:Class="LabelMeWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#20242B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4EA1FF" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="Background" Value="#343B45" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4A5360" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EBEF" />
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#20242B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#596371" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="#20242B" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="12,7" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#1769AA" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#7E8794" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
